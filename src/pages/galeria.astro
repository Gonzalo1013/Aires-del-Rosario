---
import Layout from '../layouts/Layout.astro';
import GaleriaGrid from '../components/GaleriaGrid.astro';
---

<Layout
  title="Galería de trabajos de aire acondicionado en Rosario | Aires del Rosario"
  description="Fotos reales de instalaciones, preinstalaciones, reparaciones y mantenimientos de aire acondicionado que hicimos en casas, oficinas y comercios de Rosario y Gran Rosario."
>
  <section
    class="max-w-sm sm:max-w-md md:max-w-3xl lg:max-w-6xl mx-auto pt-10 pb-12"
  >
    <h1
      class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 text-center text-gray-200"
    >
      Galería de trabajos
    </h1>
    <p
      class="max-w-2xl mx-auto mb-8 text-center text-gray-400 text-base sm:text-lg"
    >
      Instalaciones, preinstalaciones, reparaciones y mantenimientos hechos por
      nuestros técnicos en casas, oficinas y comercios de Rosario.
    </p>

    <GaleriaGrid />
  </section>
</Layout>
