---
import FrigoriasWizard from '../components/FrigoriasWizard.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Calculadora de frigorías online | Aires del Rosario"
  description="Calculá gratis cuántas frigorías necesita tu ambiente según sus metros, la cantidad de personas y los equipos electrónicos. Guía paso a paso hecha por técnicos de Rosario."
>
  <section
    class="bg-blue-50 max-w-sm sm:max-w-md md:max-w-3xl lg:max-w-6xl mx-auto mt-10 mb-12 p-10 rounded-2xl md:mb-48 lg:mb-12"
  >
    <h1 class="text-3xl font-bold mb-6 text-center">
      Calculá cuántas frigorías necesitás
    </h1>
    <FrigoriasWizard />
  </section>
</Layout>
