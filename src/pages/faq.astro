---
import Layout from '../layouts/Layout.astro';
import { FAQS } from '../data/faqs';

// El texto del schema es el mismo que se renderiza abajo: requisito de Google
// para que la página sea elegible como rich result.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ question, answer, cta }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      // El CTA es parte del texto visible, así que también va al schema.
      text: [
        ...answer,
        cta && `${cta.before} ${cta.linkText}${cta.after ?? ''}`,
      ]
        .filter(Boolean)
        .join(' '),
    },
  })),
};
---

<Layout
  title="Preguntas frecuentes sobre aire acondicionado | Aires del Rosario"
  description="Cuántas frigorías necesitás, cada cuánto hacer el mantenimiento, por qué gotea tu equipo o cuánto demora una instalación. Responden técnicos matriculados de Rosario."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    is:inline
    slot="head"
  />

  <section
    class="max-w-sm sm:max-w-md md:max-w-3xl lg:max-w-6xl mx-auto pt-10 pb-12"
  >
    <h1
      class="text-2xl sm:text-3xl md:text-4xl font-bold mb-8 text-center text-gray-200"
    >
      Preguntas frecuentes sobre aire acondicionado
    </h1>

    {
      FAQS.map(({ question, answer, cta }, i) => (
        <div class="acordeon">
          <input type="checkbox" id={`btn-acordeon${i}`} class="btn-acordeon" />
          <label for={`btn-acordeon${i}`}>{question}</label>
          <div class="contenido-acordeon">
            {answer.map((parrafo) => (
              <p>{parrafo}</p>
            ))}
            {cta && (
              /* set:html y no hijos JSX: Astro conserva los saltos de línea
                 del template como texto, y eso mete un espacio adentro del
                 <a> (subrayado de más) y otro antes del punto final. */
              <p
                set:html={`${cta.before} <a class="cta-enlace" href="${cta.href}">${cta.linkText}</a>${cta.after ?? ''}`}
              />
            )}
          </div>
        </div>
      ))
    }
  </section>
</Layout>

<style>
  .acordeon label {
    display: block;
    padding: 20px;
    font-size: 20px;
    background: #1c1c1c;
    color: #fff;
    cursor: pointer;
    margin-bottom: 2px;
    transition: all 300ms ease;
  }

  .acordeon label:hover {
    background: #2e2e2e;
  }

  .acordeon .contenido-acordeon {
    background-color: #fff;
    padding: 0 20px;
    max-height: 0;
    overflow: hidden;
    transition: all 300ms ease;
  }

  .contenido-acordeon p + p {
    margin-top: 0.75rem;
  }

  /* :global porque el enlace entra por set:html y no lleva el atributo
     data-astro-cid que Astro le agrega al markup del template; sin esto la
     regla scoped no lo alcanza. Va anidado para no filtrarse fuera del FAQ.
     El acordeón abierto tiene fondo blanco: el azul de marca es el único
     color de la paleta con contraste suficiente sobre ese fondo. */
  .contenido-acordeon :global(.cta-enlace) {
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contenido-acordeon :global(.cta-enlace:hover),
  .contenido-acordeon :global(.cta-enlace:focus-visible) {
    color: var(--color-brand-accent);
  }

  .btn-acordeon:checked ~ .contenido-acordeon {
    max-height: 600px;
    padding: 15px 20px;
  }

  /* Oculto pero enfocable: display:none lo sacaría del orden de tabulación
     y el acordeón quedaría inaccesible por teclado. */
  .btn-acordeon {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .btn-acordeon:focus-visible ~ label {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .acordeon label,
    .acordeon .contenido-acordeon {
      transition: none;
    }
  }
</style>
