---
import { Image } from 'astro:assets';
import logo from '../assets/logo-white.png';

/**
 * Único origen de los enlaces del menú: el de escritorio y el desplegable de
 * móvil se generan de acá. Antes cada enlace estaba escrito dos veces con su
 * plantilla de clases repetida, y las etiquetas ya se habían desincronizado
 * (escritorio decía "Preguntas freq." y móvil "FAQ").
 *
 * Las rutas van con barra final porque esa es la forma canónica del sitio: el
 * build genera /galeria/index.html y el <link rel="canonical"> declara
 * "/galeria/". Enlazar a "/galeria" hacía que Google descubriera cada página
 * por una URL que no es la canónica, y Search Console las reportaba como
 * "página alternativa con etiqueta canónica adecuada".
 */
const LINKS = [
  { href: '/', label: 'Inicio' },
  { href: '/galeria/', label: 'Galería' },
  { href: '/nosotros/', label: 'Nosotros' },
  { href: '/faq/', label: 'Preguntas freq.' },
];

// Ojo: esto ya viene con barra final (es /galeria/, no /galeria). Mientras
// LINKS no la llevaba, la comparación de abajo daba falso en todas las
// páginas menos el inicio y el enlace de la página actual nunca se marcaba.
const actual = Astro.url.pathname;

/** La página actual no se enlaza a sí misma: se marca y se desactiva. */
const clases = (href: string, tamanos: string) =>
  `px-3 py-2 ${tamanos} rounded transition-colors duration-200 hover:text-brand-accent ${
    actual === href
      ? 'text-brand-accent cursor-default pointer-events-none'
      : 'text-gray-100'
  }`;
---

<nav
  class="header bg-brand-translucent fixed top-4 left-4 right-4 z-50 rounded-xl shadow-md"
>
  <div
    class="max-w-sm sm:max-w-md md:max-w-3xl lg:max-w-6xl mx-auto px-4 lg:px-0"
  >
    <div class="flex justify-between h-20 items-center">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/">
          <Image
            class="logo-navbar w-28 sm:w-36 md:w-40"
            src={logo}
            alt="Aires del Rosario - instalación y reparación de aire acondicionado"
            width={160}
            height={160}
            loading="eager"
            fetchpriority="high"
          />
        </a>
      </div>

      <!-- Botón hamburguesa (móvil) -->
      <div class="md:hidden">
        <button
          id="menu-button"
          class="relative w-10 h-10 flex flex-col justify-center items-center focus:outline-none"
          aria-label="Abrir menú"
          type="button"
        >
          <span
            class="bar absolute left-2 top-3 w-6 h-0.5 bg-gray-200 transition-all duration-300"
          ></span>
          <span
            class="bar absolute left-2 top-5 w-6 h-0.5 bg-gray-200 transition-all duration-300"
          ></span>
          <span
            class="bar absolute left-2 top-7 w-6 h-0.5 bg-gray-200 transition-all duration-300"
          ></span>
        </button>
      </div>

      <!-- Menú normal (escondido en móvil) -->
      <div class="hidden md:flex space-x-2">
        {
          LINKS.map(({ href, label }) => (
            <a
              href={href}
              aria-current={actual === href ? 'page' : undefined}
              class={clases(
                href,
                'text-base sm:text-lg md:text-xl lg:text-2xl whitespace-nowrap'
              )}
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Menú desplegable (móvil).
       Ojo: el backdrop-filter de .header convierte al <nav> en bloque
       contenedor de sus descendientes `fixed`, así que este `top` es relativo
       al nav y NO al viewport. 100% = borde inferior del nav; +0.5rem es la
       separación visible. -->
  <div
    id="mobile-menu"
    class="md:hidden hidden gap-2 fixed top-[calc(100%+0.5rem)] left-0 right-0 z-40 bg-brand/90 px-4 pb-6 rounded-b-xl shadow-lg"
    style="backdrop-filter: blur(5px);"
  >
    <div class="flex flex-col">
      {
        LINKS.map(({ href, label }) => (
          <a
            href={href}
            aria-current={actual === href ? 'page' : undefined}
            class={clases(href, 'text-base sm:text-lg')}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Toggle del menú hamburguesa. La navegación la maneja <ClientRouter /> -->
  <script>
    function setupMenuToggle() {
      const menuBtn = document.getElementById('menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      if (!menuBtn || !mobileMenu) return;

      menuBtn.addEventListener('click', () => {
        const isOpen = menuBtn.classList.toggle('open');
        mobileMenu.classList.toggle('hidden', !isOpen);
        menuBtn.setAttribute('aria-expanded', String(isOpen));
      });
    }

    // astro:page-load se dispara en la carga inicial y tras cada view transition
    document.addEventListener('astro:page-load', setupMenuToggle);
  </script>
</nav>

<style>
  img.logo-navbar {
    width: 160px;
  }

  .header {
    position: fixed;
    backdrop-filter: blur(5px);
    animation: adjust-header linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes adjust-header {
    to {
      background: rgba(0, 0, 0, 0.3);
      font-size: 12px;
      height: 80px;
      border-radius: 0;
    }
  }

  /* Hamburguesa animada */
  #menu-button.open .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-button.open .bar:nth-child(2) {
    opacity: 0;
  }
  #menu-button.open .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
