---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

const services = (await getCollection('books')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Son fondos CSS, así que no puede usarse <Image />: getImage() da la misma
// optimización (WebP + resize) devolviendo sólo la URL final.
const items = await Promise.all(
  services.map(async ({ slug, data }) => ({
    slug,
    ...data,
    // 1152px es el ancho real del slot principal en escritorio. Los masters ya
    // vienen a esa medida con máscara de enfoque aplicada, así que acá no se
    // reescala. q82 es el punto elegido midiendo: por debajo la compresión se
    // come el enfoque, por encima el peso sube sin ganancia visible.
    // Las 4 fotos son fondos CSS y no se pueden diferir, así que el peso pega
    // de lleno en la ruta crítica del home.
    bg: data.img
      ? (
          await getImage({
            src: data.img,
            format: 'webp',
            width: Math.min(1152, data.img.width),
            quality: 82,
          })
        ).src
      : undefined,
  }))
);
---

<div
  id="servicios"
  class="relative w-full max-w-sm sm:max-w-md md:max-w-3xl lg:max-w-6xl mx-auto bg-gray-100 rounded-xl px-4 sm:px-0 scroll-mt-navbar"
>
  <div class="slide h-[500px]">
    {
      items.map(({ slug, title, description, bg, imgPosition }) => (
        <div
          class="item"
          style={`background-image: url(${bg}); background-position: ${imgPosition ?? 'center'}`}
        >
          <div class="content">
            <div class="name">{title}</div>
            <div class="des">{description}</div>
            <a class="cta" href={`/libro/${slug}`}>
              Ver más sobre {title.toLowerCase()}
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <div class="button">
    <button class="prev"><i class="fa-solid fa-arrow-left"></i></button>
    <button class="next"><i class="fa-solid fa-arrow-right"></i></button>
  </div>

  <script>
    function initCarousel() {
      // El tipo va explícito: querySelector devuelve Element, y más abajo hace
      // falta offsetHeight, que es de HTMLElement.
      const slide = document.querySelector<HTMLElement>('.slide');
      if (!slide) return;

      /** Adelanta una posición: la primera tarjeta se va al final de la cola. */
      const avanzar = () => {
        const items = slide.querySelectorAll('.item');
        if (items.length > 0) slide.appendChild(items[0]);
      };

      document.querySelector('.next')?.addEventListener('click', avanzar);

      document.querySelector('.prev')?.addEventListener('click', () => {
        const items = slide.querySelectorAll('.item');
        if (items.length > 0) slide.prepend(items[items.length - 1]);
      });

      // Click en una miniatura: esa foto pasa al frente.
      // Las posiciones 0 y 1 son la tarjeta grande (la 0 va detrás de la 1),
      // así que la miniatura cercana está en la 2 y la lejana en la 3: hacen
      // falta tantos avances como su posición menos uno.
      slide.addEventListener('click', (evento) => {
        const target = evento.target;
        if (!(target instanceof Element)) return;

        const item = target.closest('.item');
        if (!item) return;

        const posicion = Array.from(slide.children).indexOf(item);
        // La grande no hace nada al clickearla: ahí adentro está el enlace al
        // servicio, que tiene que seguir funcionando como enlace.
        if (posicion < 2) return;

        const saltos = posicion - 1;

        // La miniatura cercana está a un solo avance: se anima normalmente.
        if (saltos === 1) {
          avanzar();
          return;
        }

        // La lejana está a dos. Los dos avances van juntos y SIN transición,
        // por dos motivos:
        //   - animados uno tras otro, la foto del medio ocupaba el lugar
        //     grande de paso, y la idea es ir directo a la que se clickeó;
        //   - animados a la vez, la tarjeta grande saliente pasa de la
        //     posición 2 a la 5 —que está en display:none— y desaparece de un
        //     frame al otro mientras la nueva tarda medio segundo en crecer:
        //     en ese hueco se veía el fondo claro del contenedor (el destello).
        // Sin transición no hay ni foto intermedia ni hueco: el reordenamiento
        // entra en un solo frame y la nueva grande aparece con un fundido.
        const items = Array.from(slide.children);
        for (const el of items) el.classList.add('sin-transicion');

        for (let i = 0; i < saltos; i++) avanzar();

        // Fuerza el recálculo con las posiciones nuevas antes de volver a
        // habilitar la transición: si no, el navegador junta los dos cambios
        // en un solo paso y anima igual.
        void slide.offsetHeight;
        for (const el of items) el.classList.remove('sin-transicion');

        const nuevaGrande = slide.children[1];
        if (nuevaGrande) {
          nuevaGrande.classList.add('entrando');
          window.setTimeout(
            () => nuevaGrande.classList.remove('entrando'),
            400
          );
        }
      });
    }

    // astro:page-load se dispara en la carga inicial y tras cada view transition
    document.addEventListener('astro:page-load', initCarousel);
  </script>

  <style>
    .slide .item {
      width: 200px;
      height: 300px;
      position: absolute;
      top: 50%;
      transform: translate(0, -50%);
      border-radius: 20px;
      background-position: center;
      background-size: cover;
      display: inline-block;
      transition: 0.5s;
    }

    .slide .item:nth-child(1),
    .slide .item:nth-child(2) {
      top: 0 !important;
      left: 0;
      transform: translate(0, 0) !important;
      border-radius: 10px !important;
      width: 100% !important;
      height: 100% !important;
    }

    .slide .item:nth-child(3) {
      left: calc(50% + 220px);
    }

    .slide .item:nth-child(4) {
      left: calc(50% + 440px);
    }

    /* Sólo existen dos ranuras chicas (+220 y +440): una tercera a +660
       desbordaría el viewport a 1280px. De la 5ª tarjeta en adelante se
       ocultan y esperan turno. Antes caían TODAS en la ranura de +440,
       apiladas, y la última pintaba encima de la 4ª: al avanzar, la que
       estaba debajo parecía desaparecer en vez de subir un lugar. */
    .slide .item:nth-child(n + 5) {
      display: none;
    }

    /* Las miniaturas se pueden clickear para traerlas al frente. El puntero y
       el brillo al pasar por encima son la señal de que responden. El scale
       repite el translate porque `transform` es una sola propiedad: sin él se
       perdería el centrado vertical de la tarjeta. */
    .slide .item:nth-child(3),
    .slide .item:nth-child(4) {
      cursor: pointer;
    }

    .slide .item:nth-child(3):hover,
    .slide .item:nth-child(4):hover {
      transform: translate(0, -50%) scale(1.04);
      filter: brightness(1.12);
    }

    /* Salto directo a la miniatura lejana: el reordenamiento entra de una,
       sin animar el recorrido, y la nueva tarjeta grande aparece con un
       fundido corto para que el cambio no sea seco. */
    .slide .item.sin-transicion {
      transition: none;
    }

    .slide .item.entrando {
      animation: aparecer-tarjeta 300ms ease-out;
    }

    @keyframes aparecer-tarjeta {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .slide .item.entrando {
        animation: none;
      }
    }

    /* Velo degradado sólo sobre la tarjeta activa: las fotos tienen paredes
       claras y el texto blanco quedaba ilegible. Va en un ::after para no
       tocar el background-image, que se setea inline con la URL optimizada. */
    .slide .item:nth-child(2)::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: inherit;
      pointer-events: none;
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-brand-dark) 88%, transparent) 0%,
        color-mix(in srgb, var(--color-brand-dark) 55%, transparent) 30%,
        transparent 62%
      );
    }

    .item .content {
      position: absolute;
      top: 75%;
      left: 30px;
      width: 300px;
      text-align: left;
      color: #eee;
      transform: translate(0, -50%);
      font-family: system-ui;
      display: none;
      /* por encima del velo */
      z-index: 2;
    }

    .slide .item:nth-child(2) .content {
      display: block;
    }

    .content .name {
      font-size: 40px;
      text-transform: uppercase;
      font-weight: bold;
      opacity: 0;
      animation: animate 1s ease-in-out 1 forwards;
    }

    .content .des {
      opacity: 0;
      animation: animate 1s ease-in-out 0.3s 1 forwards;
    }

    .content .cta {
      display: inline-block;
      margin-top: 12px;
      padding: 6px 20px;
      opacity: 0;
      animation: animate 1s ease-in-out 0.6s 1 forwards;
      background-color: var(--color-brand-translucent);
      color: #fff;
      border-radius: 5px;
    }

    .content .cta:hover {
      background-color: var(--color-brand-accent);
    }

    @keyframes animate {
      from {
        opacity: 0;
        transform: translate(0, 100px);
        filter: blur(33px);
      }
      to {
        opacity: 1;
        transform: translate(0);
        filter: blur(0);
      }
    }

    .button {
      width: 100%;
      text-align: center;
      position: absolute;
      bottom: 20px;
    }

    .button button {
      width: 40px;
      height: 35px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      margin: 0 5px;
      background: #fff;
      border: 1px solid #000;
      transition: 0.3s;
    }

    .button button:hover {
      background: #ababab;
      color: #fff;
    }

    /* Mismo breakpoint que el overflow-x de global.css: por debajo de 1280px
       los ítems 3 y 4 caen fuera del viewport. Se usa display:none y no
       visibility:hidden porque un absoluto invisible igual sigue generando
       área desplazable, que era justamente el desborde a tapar. */
    @media (max-width: 1279.98px) {
      .slide .item {
        display: none;
      }
      .slide .item:nth-child(2) {
        display: block;
      }

      .content .name {
        font-size: 30px;
      }
    }
  </style>
</div>
