---
import { Image } from 'astro:assets';
import logo from '../assets/logo-white-footer.png';
import mailIcon from '../assets/mail-icon.png';
import instagramIcon from '../assets/instagram-icon.png';
import whatsappIcon from '../assets/whatsapp-icon.png';
import { BUSINESS } from '../data/business';
---

<footer class="bg-gray-900 text-gray-400 py-6 px-6 md:px-12 lg:px-20">
  <div
    class="max-w-sm sm:max-w-md md:max-w-3xl lg:max-w-6xl mx-auto flex justify-center gap-8"
  >
    <div>
      <div class="border-b border-gray-700 w-sm flex justify-center mb-4">
        <Image
          class="w-40 pb-4"
          src={logo}
          alt="Aires del Rosario"
          width={320}
          height={137}
          loading="lazy"
        />
      </div>

      <ul class="space-y-2 text-sm w-full">
        <li>
          <a
            href={`mailto:${BUSINESS.email}`}
            class="flex items-center gap-2 hover:text-red-400 transition justify-center"
          >
            <Image
              src={mailIcon}
              alt=""
              width={20}
              height={20}
              loading="lazy"
              class="w-5 h-5 rounded-full inline-block"
            />
            {BUSINESS.email}
          </a>
        </li>
        <li>
          <a
            href={BUSINESS.instagram}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 hover:text-pink-400 transition justify-center"
          >
            <Image
              src={instagramIcon}
              alt=""
              width={20}
              height={20}
              loading="lazy"
              class="w-5 h-5 rounded-full inline-block"
            />
            {BUSINESS.instagramHandle}
          </a>
        </li>
        <li>
          <a
            href={`https://wa.me/${BUSINESS.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 hover:text-green-400 transition justify-center"
          >
            <Image
              src={whatsappIcon}
              alt=""
              width={20}
              height={20}
              loading="lazy"
              class="w-5 h-5 rounded-full inline-block"
            />
            WhatsApp 341 229-7176
          </a>
        </li>
      </ul>

      <!-- NAP visible: debe coincidir con el JSON-LD de LocalBusiness -->
      <p class="mt-4 text-center text-sm">
        Service de aire acondicionado en {BUSINESS.city}, {BUSINESS.region}
      </p>
    </div>
  </div>

  <!-- Línea inferior -->
  <div
    class="mt-4 border-t border-gray-700 pt-6 text-center text-xs text-gray-500"
  >
    © {new Date().getFullYear()} Aires del Rosario. Todos los derechos reservados.
  </div>
</footer>
